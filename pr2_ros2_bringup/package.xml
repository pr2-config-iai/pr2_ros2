<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pr2_ros2_bringup</name>
  <version>0.0.1</version>
  <description>ROS 2 (Jazzy) bringup for the IAI PR2, ported from pr2_bringup / iai_pr2_bringup.</description>
  <maintainer email="todo@example.com">IAI PR2 team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_aggregator</exec_depend>
  <exec_depend>pr2_controllers_msgs</exec_depend>
  <exec_depend>pr2_dashboard_aggregator</exec_depend>
  <exec_depend>pr2_gripper_action</exec_depend>
  <exec_depend>pr2_power_board</exec_depend>
  <exec_depend>pr2_ros2_control</exec_depend>
  <exec_depend>pr2_run_stop_auto_restart</exec_depend>
  <exec_depend>rqt_pr2_dashboard</exec_depend>
  <exec_depend>urg_node</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
